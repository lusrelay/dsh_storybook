{
  "name": "@local/dsh-storybook",
  "version": "1.2.0",
  "description": "酒馆式故事工坊：多故事书隔离、模块化知识库、关键词三级检索、故事/游戏双模式对话",
  "author": "lusrelay",
  "license": "MIT",
  "homepage": "https://github.com/lusrelay/dsh_storybook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lusrelay/dsh_storybook.git"
  },
  "bugs": {
    "url": "https://github.com/lusrelay/dsh_storybook/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/host.test.mjs && node tests/resilience.test.mjs && node tests/index.test.mjs && node tests/timeline.test.mjs && node tests/client.test.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sillytavern",
    "storybook",
    "interactive-fiction",
    "text-rpg",
    "lorebook"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
